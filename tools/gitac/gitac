#!/usr/bin/env bash
# gitac — Git Add-Commit
#
# Stages all changes and commits with a single command.
# Ported from the shell alias:
#   gitac = "git status; echo 'adding all changes + committing them for:' ; pwd;  git add -A; git commit -m";

set -euo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
BOLD=$'\033[1m'
CYAN=$'\033[1;36m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[1;31m'
RESET=$'\033[0m'

# Disable colors if stdout is not a terminal
if [[ ! -t 1 ]]; then
    BOLD="" CYAN="" GREEN="" YELLOW="" RED="" RESET=""
fi

# ── Helpers ─────────────────────────────────────────────────────────────────
header() {
    echo -e "${CYAN}══ $1 ══${RESET}"
}

info() {
    echo -e "${GREEN}▸${RESET} $1"
}

warn() {
    echo -e "${YELLOW}▸ $1${RESET}"
}

error() {
    echo -e "${RED}✖ $1${RESET}" >&2
}

usage() {
    cat <<EOF
${BOLD}gitac${RESET} — Git Add-Commit

Stage all changes and commit in one step.

${CYAN}Usage:${RESET}
  gitac <message>                 Stage all changes and commit
  gitac -p|--push <message>       Stage, commit, and push
  gitac -n|--dry-run <message>    Show what would be committed (no changes made)
  gitac -h|--help                 Show this help

${CYAN}Examples:${RESET}
  gitac "fix typo in README"
  gitac --push "release v1.2.0"
  gitac --dry-run "check before committing"

${CYAN}Notes:${RESET}
  • Equivalent to: git add -A && git commit -m "<message>"
  • Must be run inside a git repository.
EOF
}

# ── Argument parsing ────────────────────────────────────────────────────────
PUSH=false
DRY_RUN=false
MESSAGE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -p|--push)
            PUSH=true
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -*)
            error "Unknown option: $1"
            echo
            usage
            exit 1
            ;;
        *)
            if [[ -z "$MESSAGE" ]]; then
                MESSAGE="$1"
            else
                error "Unexpected argument: $1"
                echo
                usage
                exit 1
            fi
            shift
            ;;
    esac
done

# Show help if no message was provided
if [[ -z "$MESSAGE" ]]; then
    usage
    exit 0
fi

# ── Preflight checks ───────────────────────────────────────────────────────
if ! command -v git &>/dev/null; then
    error "git is not installed or not in PATH."
    exit 1
fi

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    error "Not inside a git repository."
    exit 1
fi

# ── Summary ─────────────────────────────────────────────────────────────────
echo
header "gitac"
info "Directory: ${BOLD}$(pwd)${RESET}"
info "Message:   ${BOLD}${MESSAGE}${RESET}"
echo

header "Current status"
git status --short
echo

header "Changes to be committed"
# Stage everything first so diff --stat reflects the full picture
git add -A
DIFF_STAT=$(git diff --cached --stat)

if [[ -z "$DIFF_STAT" ]]; then
    warn "Nothing to commit — working tree is clean."
    # Unstage since we have nothing to do
    git reset HEAD --quiet 2>/dev/null || true
    exit 0
fi

echo "$DIFF_STAT"
echo

# ── Dry run ─────────────────────────────────────────────────────────────────
if [[ "$DRY_RUN" == true ]]; then
    warn "Dry run — no commit was made."
    # Unstage changes since this is a dry run
    git reset HEAD --quiet 2>/dev/null || true
    exit 0
fi

# ── Commit ──────────────────────────────────────────────────────────────────
header "Committing"
git commit -m "$MESSAGE"
echo

# ── Push (optional) ────────────────────────────────────────────────────────
if [[ "$PUSH" == true ]]; then
    header "Pushing"
    git push
    echo
fi

echo -e "${GREEN}✔ Done.${RESET}"
